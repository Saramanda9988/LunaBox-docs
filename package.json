{
  "name": "lunabox-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "docs:dev": "next dev",
    "docs:build": "next build",
    "docs:preview": "serve out -l 3000",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.10",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.10",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "serve": "^14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
